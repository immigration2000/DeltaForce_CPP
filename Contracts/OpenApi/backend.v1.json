  "components": {
    "securitySchemes": {
      "Session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque login session; not JWT. Lost on API restart; never put in a Travel URL."
      }
    },
    "schemas": {
      "Cell": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer",
            "format": "int32"
          },
          "y": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Grid",
              "EquipmentSlot"
            ]
          },
          "containerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "gridIndex": {
            "type": "integer",
            "format": "int32",
            "minimum": -1
          },
          "cellPosition": {
            "$ref": "#/components/schemas/Cell"
          },
          "rotated": {
            "type": "boolean"
          },
          "slotTag": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "type"
        ],
        "description": "Grid requires containerId, gridIndex >= 0, cellPosition >= 0, and an empty slotTag. EquipmentSlot requires slotTag, null containerId, gridIndex=-1, cellPosition omitted or (0,0), and rotated=false. Grid coordinates have a top-left origin."
      },
      "ScopeRevision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scopeId": {
            "type": "string",
            "enum": [
              "persistent:self"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "int64 encoded as a decimal string"
          }
        },
        "required": [
          "scopeId",
          "revision"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "userId",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "playerId",
          "userId",
          "token",
          "expiresAt"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "errorCode",
          "retryable"
        ]
      },
      "InventoryCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "type": "string",
            "enum": [
