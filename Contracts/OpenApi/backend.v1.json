{
  "openapi": "3.0.3",
  "info": {
    "title": "DeltaForce Backend",
    "version": "1.1.0",
    "description": "M1 authoritative lobby backend. Contracts/README.md contains integration rules and boundaries."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5099"
    }
  ],
  "security": [
    {
      "Session": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "MSSQL query succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; check the same requestId before retrying",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
